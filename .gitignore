# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest & testing caches
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env

# Dependencies & Build Artefacts
node_modules/
frontend/node_modules/
frontend/dist/
dist/

# SQLite runtime databases (uncomment if you wish to track seed data)
# *.db

# Word documents & PPTX rules
# Ensure documents in words/ and frontend/public/ are tracked
*.doc
*.docx
*.docm
*.dotx
~$*.doc*
~$*.ppt*
!words/*.docx
!words/*.pptx
!frontend/public/*.docx
!frontend/public/*.pptx

# IDE files
.vscode/
.idea/
.agents/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sw?

# Logs
*.log
